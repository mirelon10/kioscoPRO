{
  "name": "kiosco-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión para kiosco: Firebase (Auth + Firestore) y Netlify",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serve public -l 3000",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-kiosco",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kiosco \"node --test tests/rules/*.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "set-rol": "node scripts/set-rol.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "serve": "^14.2.4"
  }
}
